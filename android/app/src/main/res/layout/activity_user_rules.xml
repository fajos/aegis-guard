<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter custom AdBlock rules, hosts entries or exceptions (one per line):"
        android:textSize="13sp"
        android:textColor="#555555"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etUserRules"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="top|start"
        android:hint="||example-ad.com^\n0.0.0.0 tracking-server.net\n@@||allowed-site.com^\n||test.com^$dnsrewrite=1.2.3.4"
        android:inputType="textMultiLine"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:fontFamily="monospace"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnSaveUserRules"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save &amp; Apply Rules"
        android:layout_marginTop="12dp" />

</LinearLayout>
