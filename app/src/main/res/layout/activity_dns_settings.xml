<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upstream DNS Providers"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgDnsProviders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:padding="8dp"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbAdguardDns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AdGuard DNS (94.140.14.14, 94.140.15.15)"
                android:checked="true"
                android:padding="8dp" />

            <RadioButton
                android:id="@+id/rbAdguardFamily"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AdGuard Family (Safe search &amp; adult filter)"
                android:padding="8dp" />

            <RadioButton
                android:id="@+id/rbCloudflareDns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cloudflare DNS (1.1.1.1, 1.0.0.1)"
                android:padding="8dp" />

            <RadioButton
                android:id="@+id/rbGoogleDns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Google Public DNS (8.8.8.8, 8.8.4.4)"
                android:padding="8dp" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Advanced DNS &amp; Proxy Settings"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Parallel Upstream Queries\nRaces multiple DNS upstreams for lowest latency"
                        android:textSize="14sp"
                        android:textColor="#333333" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchParallelDns"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Optimistic DNS Caching\nServes slightly expired DNS records while updating"
                        android:textSize="14sp"
                        android:textColor="#333333" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchOptimisticCache"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Block Encrypted Client Hello (ECH)\nPrevents trackers from bypassing local inspection"
                        android:textSize="14sp"
                        android:textColor="#333333" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchBlockEch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Block IPv6 Queries (AAAA)\nForces clean IPv4 resolution to prevent IPv6 leaks"
                        android:textSize="14sp"
                        android:textColor="#333333" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchBlockIpv6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
